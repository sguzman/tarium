{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tarium public member registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "name",
          "summary",
          "repository",
          "domains",
          "ontology_path",
          "gallery_path"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "repository": {
            "type": "string",
            "pattern": "^https://github\\\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ontology_path": {
            "type": "string",
            "const": "ontology/ontology.json"
          },
          "gallery_path": {
            "type": "string",
            "const": "gallery/index.json"
          }
        }
      }
    }
  }
}
