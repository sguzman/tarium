{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tarium public member registry",
  "description": "Owner-authorized independent public repositories and their verified public ontology/gallery entry points.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projects"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "name",
          "summary",
          "repository",
          "domains",
          "ontology_path",
          "gallery_path",
          "gallery_index_path",
          "accent_color"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "repository": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ontology_path": {
            "type": "string",
            "pattern": "^(?:ontology|docs/ontology)/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.json$"
          },
          "gallery_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:md|html)$"
          },
          "gallery_index_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.json$"
          },
          "accent_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "website_url": {
            "type": "string",
            "pattern": "^https://[a-zA-Z0-9-]+\\.github\\.io/[a-zA-Z0-9_.-]+/$"
          }
        }
      }
    }
  }
}
